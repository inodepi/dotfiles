#!/usr/bin/env bash
# Super+M power menu: wofi dmenu, styled by ~/.config/wofi.
# Replaces wlogout; no external menu dependency.
#
# Usage: power-menu [--print]

set -euo pipefail

ACTIONS=("Lock" "Logout" "Suspend" "Reboot" "Shutdown")

if [[ "${1:-}" == "--print" || "${1:-}" == "-p" ]]; then
    printf '%s\n' "${ACTIONS[@]}"
    exit 0
fi

if ! command -v wofi >/dev/null 2>&1; then
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a "Power menu" -u critical "wofi is missing" "Install wofi to use Super+M."
    exit 1
fi

choice="$(
    printf '%s\n' "${ACTIONS[@]}" | wofi --dmenu \
        --prompt="Power" \
        --width=260 \
        --height=300 \
        --cache-file=/dev/null \
        --conf <(echo -e "allow-images=false\ninsensitive=true")
)" || exit 0

case "$choice" in
    Lock)     exec hyprlock ;;
    Logout)   exec hyprctl dispatch exit ;;
    Suspend)  exec systemctl suspend ;;
    Reboot)   exec systemctl reboot ;;
    Shutdown) exec systemctl poweroff ;;
    *)        exit 0 ;;
esac
